{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@lumen/schemas": ["../../packages/schemas/dist"],
      "@lumen/schemas/*": ["../../packages/schemas/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"],
  "noUncheckedIndexedAccess": true,
  "exactOptionalPropertyTypes": true
}
